#!/bin/sh
# Valide les manifestes du plugin avant chaque commit (chantier V).
# Activer une fois par clone : git config core.hooksPath .githooks
racine=$(git rev-parse --show-toplevel) || exit 1

# Aucun chemin de machine dans un dépôt public (chantier CHM) : les seules lignes ajoutées — l'historique poussé
# garde les anciennes. Trois formes : un dossier d'utilisateur Windows, sa vue WSL, et le nom de dossier qu'en tire
# ~/.claude/projects. Écrire `~` ou `<nom>` à la place.
chemins=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep '^+' | grep -v '^+++' \
  | grep -i -E '[a-z]:[/\\]{1,2}users[/\\]{1,2}[a-z]|/mnt/[a-z]/users/[a-z]|[a-z]--users-[a-z]')
if [ -n "$chemins" ]; then
  printf '%s\n' "$chemins" >&2
  echo "pre-commit : chemin de machine dans une ligne ajoutée — écrire ~ ou <nom>, commit refusé." >&2
  exit 1
fi

# pyright, si le commit indexe un .py (chantier TYP) ; avant claude, dont l'absence sort par exit 0.
# Il lit l'arbre de travail, pas l'index : un .py corrigé mais non indexé passe. Par `uv run`, l'atelier de
# `pyproject.toml`, sans toucher au verrou (`--frozen`) ; ni uv ni pyright : le commit est refusé, jamais
# passé en silence (REF3, défaut E27).
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.py$'; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit : uv introuvable, pyright non lancé, commit refusé — installer uv, puis uv sync." >&2
    exit 1
  fi
  if ! sortie=$(cd "$racine" && uv run --frozen pyright 2>&1); then
    printf '%s\n' "$sortie" >&2
    echo "pre-commit : pyright en erreur ou absent de l'atelier (uv sync), commit refusé." >&2
    exit 1
  fi
fi

# claude : demandé à `vlp.py claude`, seule recherche du kit — PATH, puis l'app Claude sous Windows (chantiers VAL,
# CLI, VIT19). `py -3` d'abord : le `python3` du Store voit un AppData virtualisé, sans l'app (`claude_de`, boucle.py).
if command -v py >/dev/null 2>&1; then
  python="py -3"
elif command -v python3 >/dev/null 2>&1; then
  python=python3
else
  echo "pre-commit : Python introuvable, claude non cherché, validate sauté." >&2
  exit 0
fi
trouve=$($python "$racine/scripts/vlp.py" claude 2>&1 | tr -d '\r')
case $trouve in
  "CLAUDE "*)
    claude_exe=${trouve#CLAUDE } ;;
  "GARDE: claude.exe introuvable"*)
    # Ni app ni claude : un clone chez quelqu'un sans Claude passe, averti.
    echo "pre-commit : claude introuvable, ni dans le PATH ni dans l'app, validate sauté." >&2
    exit 0 ;;
  "GARDE: claude.exe absent de l'app"*)
    # L'app est là, son claude.exe ailleurs que prévu : refusé, jamais sauté en silence (VIT19).
    printf '%s\n' "$trouve" >&2
    echo "pre-commit : l'app Claude est là sans claude.exe trouvé, validate impossible, commit refusé." >&2
    exit 1 ;;
  *)
    printf '%s\n' "$trouve" >&2
    echo "pre-commit : vlp.py claude en erreur, commit refusé." >&2
    exit 1 ;;
esac

# plugin.json d'abord : valider marketplace.json le relit, et nommerait le mauvais fichier (chantier REV).
for m in .claude-plugin/plugin.json .claude-plugin/marketplace.json; do
  if ! sortie=$("$claude_exe" plugin validate "$racine/$m" 2>&1); then
    printf '%s\n' "$sortie" >&2
    echo "pre-commit : $m invalide, commit refusé." >&2
    exit 1
  fi
done
