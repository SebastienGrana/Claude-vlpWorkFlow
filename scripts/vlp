#!/bin/sh
# Lance scripts/vlp.py avec le premier Python qui répond : python3, python, py.
# Les commandes du kit l'appellent sans accolade : sh "<kit>/scripts/vlp" <sous-commande> …
# « mesure » en premier argument lance scripts/mesure-tokens.py à la place.
# Sous Windows, python3 est souvent le faux raccourci du Store : « -c "" » l'écarte.
case $0 in
  */*) ici=${0%/*} ;;
  *\\*) ici=${0%\\*} ;;
  *) ici=. ;;
esac
script=vlp.py
if [ "$1" = mesure ]; then
  script=mesure-tokens.py
  shift
fi
for p in python3 python py; do
  if "$p" -c "" >/dev/null 2>&1; then
    exec "$p" "$ici/$script" "$@"
  fi
done
echo "vlp : aucun Python ne répond (python3, python, py)" >&2
exit 127
